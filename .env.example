# KSP Dristi - Environment Configuration Template
# Copy this file to '.env.local' and add your actual API keys.

# Groq API Key for live Llama-3.3-70b-versatile model inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gemini API Key (optional fallback for gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# News API Key for live Bengaluru/Karnataka crime and news intelligence feed
NEWS_API_KEY=your_news_api_key_here

# Zoho Catalyst Database/Project Configuration
# (Kept strictly server-side inside .env.local and NEVER exposed to the browser/client-side code)
ZOHO_CATALYST_PROJECT_ID=your_zoho_catalyst_project_id_here
ZOHO_CATALYST_ZAID=your_zoho_catalyst_zaid_here
ZOHO_CATALYST_CLIENT_ID=your_zoho_catalyst_client_id_here
ZOHO_CATALYST_CLIENT_SECRET=your_zoho_catalyst_client_secret_here
ZOHO_CATALYST_REFRESH_TOKEN=your_zoho_catalyst_refresh_token_here


